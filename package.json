{
  "name": "borsa-bot",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "packages/modules/*",
    "core/*",
    "services/*"
  ],
  "scripts": {
    "test": "vitest run",
    "db:migrate": "psql $DATABASE_URL -f db-schemas/04-funding-rates.sql -f db-schemas/migrations/2026-10-27-01-carry.sql",
    "dev:carry": "node --env-file=.env services/service-carry/main.js",
    "carry:scan": "node --env-file=.env services/service-carry/src/scan.js",
    "carry:backtest": "node --env-file=.env services/service-carry/src/backtest.js",
    "carry:backfill-funding": "node --env-file=.env services/service-carry/src/backfill-funding.js"
  },
  "devDependencies": {
    "vitest": "~2.0.0"
  }
}
