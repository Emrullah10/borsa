# Node
NODE_ENV=production

# Postgres (personelweb-postgres-1 ile bağlantı)
DATABASE_URL=postgres://personel:personel@localhost:5432/borsabot

# Redis
CORE_REDIS_URL=redis://localhost:6379
CORE_DISCOVERY_REDIS_URL=redis://localhost:6379

# Service ports
MARKET_DATA_PORT=3101
SIGNAL_ENGINE_PORT=3102

# İzlenecek coin'ler: boş=10 popüler, TOP veya TOP:N=hacme göre en likit N coin, virgüllü liste
MARKET_DATA_SYMBOLS=TOP:50

# Bitget (public WS requires no key; REST backtest needs these)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Telegram (service-notifier)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Notifier (service-notifier)
GMAIL_USER=emrullahbozkurt06@gmail.com
GMAIL_APP_PASSWORD=cemu uarl dehv uilc
EMAIL_TO=emrullahbozkurt06@gmail.com
