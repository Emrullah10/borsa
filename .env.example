# Node
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://botuser:botpass@localhost:5432/borsabot

# Redis
CORE_REDIS_URL=redis://localhost:6379
CORE_DISCOVERY_REDIS_URL=redis://localhost:6379

# Service ports
MARKET_DATA_PORT=3101
SIGNAL_ENGINE_PORT=3102

# İzlenecek coin'ler:
#   boş            → 10 popüler coin (varsayılan)
#   TOP veya TOP:N → hacme göre en likit N coin (N yoksa 50). Önerilen.
#   virgüllü liste → o coin'ler, örn. BTCUSDT,ETHUSDT,SOLUSDT
#   ALL            → ~595 coin; Bitget WS limitine (code 30006) takılır, önerilmez
# MARKET_DATA_SYMBOLS=TOP:50

# Bitget (public WS requires no key; REST backtest needs these)
BITGET_API_KEY=
BITGET_SECRET_KEY=
BITGET_PASSPHRASE=

# Telegram (service-notifier — empty for now)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Email Notifier (service-notifier)
GMAIL_USER=
GMAIL_APP_PASSWORD=
EMAIL_TO=

# Funding Carry (service-carry, port 3104) — kâğıt üstü delta-nötr funding toplayıcı
CARRY_PORT=3104
CARRY_MODE=paper
CARRY_PAPER_CAPITAL=1000

# AI risk bekçisi: none (varsayılan) | openrouter | ollama — kâr kararına etkisi yok, duyuruları kural katmanı zaten okur
# OpenRouter anahtarı: https://openrouter.ai/settings/keys — Auto Router + ucuz model havuzu, çağrı başı ~$0.0002
AI_PROVIDER=none
OPENROUTER_API_KEY=
# Boş → openrouter/auto. Sabit model için örn: deepseek/deepseek-v4-flash
AI_MODEL=
# Boş → varsayılan ucuz havuz (llm-client.js DEFAULT_ALLOWED_MODELS). Virgüllü, joker destekli.
AI_ALLOWED_MODELS=
