# Node
NODE_ENV=development

# Postgres
DATABASE_URL=postgres://botuser:botpass@localhost:5432/borsabot

# Redis (servis kaydı)
CORE_REDIS_URL=redis://localhost:6379
CORE_DISCOVERY_REDIS_URL=redis://localhost:6379

# Telegram — açılış/kapanış, risk uyarısı ve günlük rapor
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Funding Carry (service-carry, port 3104) — kâğıt üstü delta-nötr funding toplayıcı
CARRY_PORT=3104
CARRY_MODE=paper
CARRY_PAPER_CAPITAL=1000

# AI risk bekçisi: none (varsayılan) | openrouter | ollama — kâr kararına etkisi yok, duyuruları kural katmanı zaten okur
# OpenRouter anahtarı: https://openrouter.ai/settings/keys — Auto Router + ucuz model havuzu, çağrı başı ~$0.0002
AI_PROVIDER=none
OPENROUTER_API_KEY=
# Boş → openrouter/auto. Sabit model için örn: deepseek/deepseek-v4-flash
AI_MODEL=
# Boş → varsayılan ucuz havuz (llm-client.js DEFAULT_ALLOWED_MODELS). Virgüllü, joker destekli.
AI_ALLOWED_MODELS=
