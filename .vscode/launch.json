{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Market Data Service",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/services/service-market-data/main.js",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Signal Engine Service",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/services/service-signal-engine/main.js",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Notifier Service",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/services/service-notifier/main.js",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Tracker Service",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/services/service-tracker/main.js",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Backend: Backtest Service",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/services/service-backtest/main.js",
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "type": "python",
      "request": "launch",
      "name": "Backend: AI Service (FastAPI)",
      "python": "${workspaceFolder}/services/service-ai/.venv/bin/python",
      "module": "uvicorn",
      "args": [
        "main:app",
        "--host",
        "0.0.0.0",
        "--port",
        "3110",
        "--reload"
      ],
      "cwd": "${workspaceFolder}/services/service-ai",
      "jinja": true,
      "console": "internalConsole"
    },
    {
      "type": "node",
      "request": "launch",
      "name": "Frontend: Vite Dev Server",
      "cwd": "${workspaceFolder}/web-app",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "console": "internalConsole"
    },
    {
      "type": "chrome",
      "request": "launch",
      "name": "Frontend: Chrome Debugger",
      "url": "http://localhost:5180",
      "webRoot": "${workspaceFolder}/web-app"
    }
  ],
  "compounds": [
    {
      "name": "🚀 Backend: Tümü",
      "stopAll": true,
      "restartAll": true,
      "configurations": [
        "Backend: Market Data Service",
        "Backend: Signal Engine Service",
        "Backend: AI Service (FastAPI)",
        "Backend: Notifier Service",
        "Backend: Tracker Service"
      ]
    },
    {
      "name": "Backend: All Services (Market + Signal + AI)",
      "stopAll": true,
      "configurations": [
        "Backend: Market Data Service",
        "Backend: Signal Engine Service",
        "Backend: AI Service (FastAPI)"
      ]
    },
    {
      "name": "Fullstack: All Services (Market + Signal + AI + Frontend)",
      "stopAll": true,
      "configurations": [
        "Backend: Market Data Service",
        "Backend: Signal Engine Service",
        "Backend: AI Service (FastAPI)",
        "Frontend: Vite Dev Server"
      ]
    }
  ]
}
